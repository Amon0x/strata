{
  "colorDigitCounts": [3, 4, 6, 8],
  "format": "strata.lexical",
  "keywords": [
    "animation", "component", "derived", "else", "extends", "false", "for", "from", "if",
    "import", "in", "null", "overlay", "root", "screen", "state", "style", "to", "true",
    "when", "where"
  ],
  "numberBodyPattern": "[0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?",
  "numericUnits": ["ms", "s"],
  "operators": ["->", "&&", "||", "==", "!=", "<=", ">=", "??", "+", "-", "*", "/", "%", "!", "=", "<", ">"],
  "punctuation": ["(", ")", "{", "}", "[", "]", ",", ".", ":", ";", "?"],
  "version": 1
}
