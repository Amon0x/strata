{
  "colorDigitCounts": [3, 4, 6, 8],
  "format": "strata.lexical",
  "keywords": [
    "animation", "async", "await", "break", "catch", "component", "continue", "derived", "else",
    "extends", "false", "fn", "for", "from", "if", "import", "in", "let", "null", "overlay",
    "return", "root", "screen", "state", "style", "throw", "to", "true", "try", "var", "when",
    "where", "while"
  ],
  "numberBodyPattern": "[0-9](?:_?[0-9])*(?:\\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9](?:_?[0-9])*)?",
  "numericUnits": ["ms", "s"],
  "operators": ["...", "=>", "+=", "-=", "*=", "/=", "%=", "->", "&&", "||", "==", "!=", "<=", ">=", "??", "+", "-", "*", "/", "%", "!", "=", "<", ">"],
  "punctuation": ["(", ")", "{", "}", "[", "]", ",", ".", ":", ";", "?"],
  "version": 1
}
