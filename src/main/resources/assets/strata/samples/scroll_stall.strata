// Scrolling while the UI thread is busy: a timer stalls it for a while, every 1.5 seconds. The list
// is an ordinary scroll view, so the wheel keeps moving it during the stall (see frame-threads.md).

fn stall() {
  var i = 0
  while i < 1000000 {
    i += 1
  }
}

style Row {
  kind: "ROW";
  width: { weight: 1 };
  height: 40;
  padding: 8;
}

overlay ScrollStall {
  state stalls = 0;
  root Panel(
    layout: { kind: "COLUMN", width: { weight: 1 }, height: { weight: 1 }, gap: 8, padding: 12 },
    timers: [{ id: "stall", every: 1500ms, action: () => { stall(); stalls = stalls + 1 } }]
  ) {
    Text(key: "stalls", text: format("Stalls so far: {0}", stalls))
    Scroll(key: "list", vertical: true, horizontal: false,
           layout: { width: { weight: 1 }, height: { weight: 1 } }) {
      Panel(layout: { kind: "COLUMN", width: { weight: 1 }, height: "content", gap: 4 }) {
        Panel(style: Row) { Text(text: "Row 0") }
        Panel(style: Row) { Text(text: "Row 1") }
        Panel(style: Row) { Text(text: "Row 2") }
        Panel(style: Row) { Text(text: "Row 3") }
        Panel(style: Row) { Text(text: "Row 4") }
        Panel(style: Row) { Text(text: "Row 5") }
        Panel(style: Row) { Text(text: "Row 6") }
        Panel(style: Row) { Text(text: "Row 7") }
        Panel(style: Row) { Text(text: "Row 8") }
        Panel(style: Row) { Text(text: "Row 9") }
        Panel(style: Row) { Text(text: "Row 10") }
