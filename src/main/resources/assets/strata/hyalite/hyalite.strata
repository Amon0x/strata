// Hyalite, after the water-clear opal that looks like poured glass: one glass material, a small
// set of surfaces cut from it, and the controls built on those surfaces. Applications import this
// module and compose the components; the material itself is the `hyalite:glass` effect declared in
// hyalite.schemas.json.
//
// Every surface is the same shader with different numbers:
//   blur / downsample   how much the backdrop is softened before it reaches the glass
//   tint                colour laid into the body; its alpha is the strength
//   refraction / bezel  how hard and how wide the edge lens bends the backdrop
//   dispersion          colour fringing inside that bend
//   saturation          colour lift of the transmitted backdrop
//   specular            strength of the rim light
//   brightness / shade  exposure of the body, and how firmly it is held in its scheme's band
//
// Glass adapts to what is behind it. A surface that carries the `strata.backdrop` behavior is told
// whether its backdrop is light or dark, and answers by setting its `tone`: 0 keeps the content's
// light ink and holds the body dark enough to carry it, 1 mirrors that ink to dark and lifts the
// body pale. Tone is inherited, so everything inside a surface follows it without being told, and
// a surface that must not follow (accent, lit) sets its own.

style GlassNone { background: null; border: null; }

// Regular: the default surface for cards and bars. Enough blur to carry text over anything.
style GlassRegular extends GlassNone {
  effect: effect(
    "hyalite:glass",
    blur: 14, downsample: 2, tint: #0A102026,
    refraction: 1.0, bezel: 18, dispersion: 0.9, saturation: 1.35,
    specular: 1.0, brightness: 1.0, shade: 0.45
  );
  shadows: [
    { color: #0000003A, radius: 34, spread: 0, offsetY: 14 },
    { color: #00000026, radius: 5, spread: 0, offsetY: 2 }
  ];
}

// Clear: barely blurred, for small floating controls where the lens is the point.
style GlassClear extends GlassNone {
  effect: effect(
    "hyalite:glass",
    blur: 2.5, downsample: 1, tint: #FFFFFF0D,
    refraction: 1.2, bezel: 20, dispersion: 1.2, saturation: 1.25,
    specular: 1.0, brightness: 1.03, shade: 0.25
  );
  shadows: [
    { color: #00000034, radius: 26, spread: 0, offsetY: 10 },
    { color: #00000022, radius: 4, spread: 0, offsetY: 1 }
  ];
}

// Frosted: heavy blur and a deeper tint, for sheets that hold a lot of text.
style GlassFrosted extends GlassNone {
  effect: effect(
    "hyalite:glass",
    blur: 30, downsample: 4, tint: #0A10204D,
    refraction: 0.9, bezel: 16, dispersion: 0.6, saturation: 1.5,
    specular: 0.9, brightness: 1.0, shade: 0.6
  );
  shadows: [
    { color: #00000040, radius: 34, spread: 0, offsetY: 14 },
    { color: #00000026, radius: 5, spread: 0, offsetY: 2 }
  ];
}

// Control: the surface of a button or pill resting on the wallpaper.
style GlassControl extends GlassNone {
  effect: effect(
    "hyalite:glass",
    blur: 8, downsample: 2, tint: #FFFFFF14,
    refraction: 1.1, bezel: 14, dispersion: 1.0, saturation: 1.3,
    specular: 1.0, brightness: 1.02, shade: 0.35
  );
  shadows: [
    { color: #00000030, radius: 18, spread: 0, offsetY: 7 },
    { color: #00000020, radius: 3, spread: 0, offsetY: 1 }
  ];
}

// Inset: a control that sits on another glass surface. No shadow of its own, and a brighter body
// so it separates from the card beneath it.
style GlassInset extends GlassNone {
  effect: effect(
    "hyalite:glass",
    blur: 4, downsample: 2, tint: #FFFFFF1F,
    refraction: 1.1, bezel: 12, dispersion: 0.9, saturation: 1.15,
    specular: 0.95, brightness: 1.06, shade: 0.2
  );
}

// Accent: glass with colour poured into it, for the one action that matters.
style GlassAccent extends GlassNone {
  effect: effect(
    "hyalite:glass",
    blur: 8, downsample: 2, tint: #0A84FFB8,
    refraction: 1.1, bezel: 14, dispersion: 1.0, saturation: 1.3,
    specular: 1.1, brightness: 1.05, shade: 0.0
  );
  shadows: [
    { color: #0A84FF55, radius: 22, spread: 0, offsetY: 8 },
    { color: #00000020, radius: 3, spread: 0, offsetY: 1 }
  ];
}

// Lit: a control in its "on" state, bright enough to carry dark ink.
style GlassLit extends GlassNone {
  effect: effect(
    "hyalite:glass",
    blur: 6, downsample: 2, tint: #FFFFFFD9,
    refraction: 1.1, bezel: 12, dispersion: 0.9, saturation: 1.2,
    specular: 1.0, brightness: 1.1, shade: 0.0
  );
}

// Droplet: the thumb of a switch or slider, and the selection lens of a segmented control. Almost
// all lens: the bezel runs to the centre, so it bends everything that passes beneath it.
style GlassDroplet extends GlassNone {
  radius: 999;
  effect: effect(
    "hyalite:glass",
    blur: 1.5, downsample: 1, tint: #FFFFFF38,
    refraction: 1.2, bezel: 13, dispersion: 0.5, saturation: 1.2,
    specular: 1.15, brightness: 1.1, shade: 0.0
  );
  shadows: [
    { color: #0000003C, radius: 10, spread: 0, offsetY: 3 }
  ];
}

// Lens: a free-standing magnifier. No blur at all, and a wide, strong bezel.
style GlassLens extends GlassNone {
  radius: 999;
  effect: effect(
    "hyalite:glass",
    blur: 0.5, downsample: 1, tint: #FFFFFF08,
    refraction: 1.45, bezel: 46, dispersion: 0.7, saturation: 1.12,
    specular: 1.2, brightness: 1.03, shade: 0.0
  );
  shadows: [
    { color: #00000050, radius: 38, spread: 0, offsetY: 18 },
    { color: #00000030, radius: 6, spread: 0, offsetY: 2 }
  ];
}

// A recessed channel cut into a glass surface: slider tracks, switch bodies, segmented wells.
style GlassWell {
  background: #00000042;
  border: { width: 1, color: #FFFFFF14 };
  radius: 999;
}

// Type. Two faces, the Surface's default and default-medium, which the application maps to the
// platform's own interface face where it is installed and to a bundled one elsewhere. Sizes are
// whole pixels so hinting lands cleanly, line heights are fixed so a different face cannot move the
// layout, and tracking follows size: large type is drawn in, small capitals are let out. Ink is
// white at four strengths; the glass keeps a contrast floor beneath it and tone turns it dark.
style GlassDisplay {
  font: "strata:fonts/default-medium"; pixelSize: 44; lineHeight: 50; letterSpacing: -0.9;
  color: #FFFFFFFF;
}
style GlassTitle {
  font: "strata:fonts/default-medium"; pixelSize: 21; lineHeight: 26; letterSpacing: -0.25;
  color: #FFFFFFFA;
}
style GlassHeadline {
  font: "strata:fonts/default-medium"; pixelSize: 15; lineHeight: 20; letterSpacing: -0.1;
  color: #FFFFFFF5;
}
style GlassBody { font: "strata:fonts/default"; pixelSize: 15; lineHeight: 22; color: #FFFFFFD9; }
style GlassLabel { font: "strata:fonts/default-medium"; pixelSize: 14; lineHeight: 18; color: #FFFFFFF2; }
style GlassCaption { font: "strata:fonts/default"; pixelSize: 12; lineHeight: 16; color: #FFFFFFA8; }
style GlassOverline {
  font: "strata:fonts/default-medium"; pixelSize: 11; lineHeight: 14; letterSpacing: 0.9;
  color: #FFFFFF94;
}
style GlassInk { font: "strata:fonts/default-medium"; pixelSize: 14; lineHeight: 18; color: #0B1220F2; }

animation GlassPress {
  duration: 150ms; easing: "cubic-out";
  from { scale: 1; }
  to { scale: 1.06; }
}
animation GlassGrab {
  duration: 170ms; easing: "cubic-out";
  from { scale: 1; }
  to { scale: 1.28; }
}
animation GlassAppear {
  duration: 260ms; easing: "cubic-out";
  from { opacity: 0; scale: 0.86; }
  to { opacity: 1; scale: 1; }
}

// Icons are authored outlines, drawn in the ink the caller passes.
component GlassIcon(name: string, size: number = 22, ink: color = #FFFFFFF2, weight: number = 2) {
  when name {
    "search" -> {
      Draw(style: GlassNone, layout: { width: size, height: size }, shapes: [
        { kind: "circle", center: { x: 0.44, y: 0.44 }, radius: 0.27, stroke: ink, strokeStyle: { width: weight } },
        { kind: "path", commands: "M .64 .64 L .88 .88", stroke: ink, strokeStyle: { width: weight, cap: "round" } }
      ])
    }
    "play" -> {
      Draw(style: GlassNone, layout: { width: size, height: size }, shapes: [
        { kind: "path", commands: "M .30 .17 L .84 .50 L .30 .83 Z", fill: ink, stroke: ink, strokeStyle: { width: weight, join: "round" } }
      ])
    }
    "pause" -> {
      Draw(style: GlassNone, layout: { width: size, height: size }, shapes: [
        { kind: "path", commands: "M .33 .22 V .78 M .67 .22 V .78", stroke: ink, strokeStyle: { width: weight * 2.2, cap: "round" } }
      ])
    }
    "forward" -> {
      Draw(style: GlassNone, layout: { width: size, height: size }, shapes: [
        { kind: "path", commands: "M .10 .24 L .48 .50 L .10 .76 Z M .52 .24 L .90 .50 L .52 .76 Z", fill: ink, stroke: ink, strokeStyle: { width: weight * 0.7, join: "round" } }
      ])
    }
    "backward" -> {
      Draw(style: GlassNone, layout: { width: size, height: size }, shapes: [
        { kind: "path", commands: "M .90 .24 L .52 .50 L .90 .76 Z M .48 .24 L .10 .50 L .48 .76 Z", fill: ink, stroke: ink, strokeStyle: { width: weight * 0.7, join: "round" } }
      ])
    }
    "wifi" -> {
      Draw(style: GlassNone, layout: { width: size, height: size }, shapes: [
        { kind: "path", commands: "M .08 .40 Q .50 .04 .92 .40 M .23 .57 Q .50 .33 .77 .57 M .38 .73 Q .50 .62 .62 .73", stroke: ink, strokeStyle: { width: weight, cap: "round" } },
        { kind: "circle", center: { x: 0.5, y: 0.87 }, radius: 0.045, fill: ink }
      ])
    }
    "bluetooth" -> {
      Draw(style: GlassNone, layout: { width: size, height: size }, shapes: [
        { kind: "path", commands: "M .28 .30 L .70 .70 L .50 .90 V .10 L .70 .30 L .28 .70", stroke: ink, strokeStyle: { width: weight, cap: "round", join: "round" } }
      ])
    }
    "airdrop" -> {
      Draw(style: GlassNone, layout: { width: size, height: size }, shapes: [
        { kind: "path", commands: "M .30 .74 C .08 .52 .22 .16 .50 .16 C .78 .16 .92 .52 .70 .74 M .40 .62 C .28 .50 .36 .34 .50 .34 C .64 .34 .72 .50 .60 .62", stroke: ink, strokeStyle: { width: weight, cap: "round" } },
        { kind: "path", commands: "M .50 .56 L .64 .86 H .36 Z", fill: ink, stroke: ink, strokeStyle: { width: weight * 0.6, join: "round" } }
      ])
    }
    "moon" -> {
      Draw(style: GlassNone, layout: { width: size, height: size }, shapes: [
        { kind: "path", commands: "M .82 .60 C .54 .70 .30 .46 .40 .18 C .14 .26 .06 .58 .26 .78 C .46 .96 .76 .88 .82 .60 Z", fill: ink, stroke: ink, strokeStyle: { width: weight * 0.6, join: "round" } }
      ])
    }
    "sun" -> {
      Draw(style: GlassNone, layout: { width: size, height: size }, shapes: [
        { kind: "circle", center: { x: 0.5, y: 0.5 }, radius: 0.17, fill: ink },
        { kind: "path", commands: "M .50 .08 V .20 M .50 .80 V .92 M .08 .50 H .20 M .80 .50 H .92 M .20 .20 L .29 .29 M .71 .71 L .80 .80 M .80 .20 L .71 .29 M .29 .71 L .20 .80", stroke: ink, strokeStyle: { width: weight, cap: "round" } }
      ])
    }
    "speaker" -> {
      Draw(style: GlassNone, layout: { width: size, height: size }, shapes: [
        { kind: "path", commands: "M .10 .40 H .26 L .48 .22 V .78 L .26 .60 H .10 Z", fill: ink, stroke: ink, strokeStyle: { width: weight * 0.6, join: "round" } },
        { kind: "path", commands: "M .62 .36 Q .74 .50 .62 .64 M .74 .24 Q .96 .50 .74 .76", stroke: ink, strokeStyle: { width: weight, cap: "round" } }
      ])
    }
    "home" -> {
      Draw(style: GlassNone, layout: { width: size, height: size }, shapes: [
        { kind: "path", commands: "M .14 .46 L .50 .14 L .86 .46 V .86 H .60 V .62 H .40 V .86 H .14 Z", stroke: ink, strokeStyle: { width: weight, cap: "round", join: "round" } }
      ])
    }
    "grid" -> {
      Draw(style: GlassNone, layout: { width: size, height: size }, shapes: [
        { kind: "path", commands: "M .16 .16 H .42 V .42 H .16 Z M .58 .16 H .84 V .42 H .58 Z M .16 .58 H .42 V .84 H .16 Z M .58 .58 H .84 V .84 H .58 Z", stroke: ink, strokeStyle: { width: weight, join: "round" } }
      ])
    }
    "library" -> {
      Draw(style: GlassNone, layout: { width: size, height: size }, shapes: [
        { kind: "path", commands: "M .20 .16 V .84 M .40 .16 V .84 M .58 .22 L .80 .82", stroke: ink, strokeStyle: { width: weight * 1.3, cap: "round" } }
      ])
    }
    "gear" -> {
      Draw(style: GlassNone, layout: { width: size, height: size }, shapes: [
        { kind: "path", commands: "M .40 .09 L .59 .09 L .62 .22 L .72 .27 L .84 .23 L .94 .40 L .84 .50 L .84 .59 L .92 .69 L .82 .85 L .69 .81 L .60 .87 L .58 .98 L .40 .98 L .37 .85 L .27 .80 L .14 .84 L .05 .68 L .15 .58 L .15 .46 L .06 .37 L .16 .22 L .29 .27 L .38 .21 Z M .65 .53 C .65 .73 .35 .73 .35 .53 C .35 .33 .65 .33 .65 .53", stroke: ink, strokeStyle: { width: weight * 0.85, join: "round" } }
      ])
    }
    "heart" -> {
      Draw(style: GlassNone, layout: { width: size, height: size }, shapes: [
        { kind: "path", commands: "M .50 .87 L .15 .53 C -.09 .25 .22 -.02 .50 .24 C .78 -.02 1.09 .25 .85 .53 Z", fill: ink, stroke: ink, strokeStyle: { width: weight * 0.5, join: "round" } }
      ])
    }
    "bell" -> {
      Draw(style: GlassNone, layout: { width: size, height: size }, shapes: [
        { kind: "path", commands: "M .20 .72 Q .30 .62 .30 .44 C .30 .14 .70 .14 .70 .44 Q .70 .62 .80 .72 Z M .42 .84 Q .50 .92 .58 .84", stroke: ink, strokeStyle: { width: weight, cap: "round", join: "round" } }
      ])
    }
    "person" -> {
      Draw(style: GlassNone, layout: { width: size, height: size }, shapes: [
        { kind: "circle", center: { x: 0.5, y: 0.33 }, radius: 0.17, stroke: ink, strokeStyle: { width: weight } },
        { kind: "path", commands: "M .16 .88 C .18 .58 .82 .58 .84 .88", stroke: ink, strokeStyle: { width: weight, cap: "round" } }
      ])
    }
    "note" -> {
      Draw(style: GlassNone, layout: { width: size, height: size }, shapes: [
        { kind: "path", commands: "M .36 .76 V .24 L .80 .15 V .67", stroke: ink, strokeStyle: { width: weight, cap: "round", join: "round" } },
        { kind: "circle", center: { x: 0.26, y: 0.77 }, radius: 0.11, fill: ink },
        { kind: "circle", center: { x: 0.70, y: 0.68 }, radius: 0.11, fill: ink }
      ])
    }
    "sparkle" -> {
      Draw(style: GlassNone, layout: { width: size, height: size }, shapes: [
        { kind: "path", commands: "M .50 .06 Q .55 .45 .94 .50 Q .55 .55 .50 .94 Q .45 .55 .06 .50 Q .45 .45 .50 .06 Z", fill: ink }
      ])
    }
    else -> {
      Draw(style: GlassNone, layout: { width: size, height: size }, shapes: [
        { kind: "path", commands: "M .50 .16 V .84 M .16 .50 H .84", stroke: ink, strokeStyle: { width: weight, cap: "round" } }
      ])
    }
  }
}

// An adaptive surface: a sheet of glass that fills its parent, follows its backdrop, and lays its
// content out as `kind`. `look` is "regular", "clear", "frosted" or "control". Size it with the
// panel you put it in; set `fillHeight: false` for a card that should wrap its content instead.
component GlassSurface(
  look: string = "regular",
  radius: number = 30,
  kind: string = "COLUMN",
  align: string = "START",
  pad: number = 0,
  gap: number = 0,
  fillHeight: boolean = true
) {
  state onLight = false;
  Panel(
    style: style(
      look == "clear" ? GlassClear
        : look == "frosted" ? GlassFrosted
        : look == "control" ? GlassControl
        : GlassRegular,
      radius: radius,
      tone: onLight ? 1 : 0
    ),
    animateChanges: { properties: ["tone"], policy: "standard" },
    layout: {
      kind: "OVERLAY", width: { weight: 1 }, height: fillHeight ? { weight: 1 } : "content",
      padding: pad
    },
    behaviors: [{ id: "strata.backdrop", action: action("state.setFromEvent", name: "onLight") }]
  ) {
    Slot(
      name: "content",
      style: GlassNone,
      layout: {
        kind: kind == "ROW" ? "ROW" : kind == "OVERLAY" ? "OVERLAY" : "COLUMN",
        width: { weight: 1 }, height: fillHeight ? { weight: 1 } : "content", gap: gap,
        alignItems: align == "CENTER" ? "CENTER" : align == "END" ? "END" : "START"
      }
    )
  }
}

// An adaptive capsule that wraps its content in a row: toolbar titles, chips, badges.
component GlassPill(height: number = 48, gap: number = 10, padLeft: number = 18, padRight: number = 20) {
  state onLight = false;
  Panel(
    style: style(GlassControl, radius: 999, tone: onLight ? 1 : 0),
    animateChanges: { properties: ["tone"], policy: "standard" },
    layout: {
      kind: "ROW", width: "content", height: height,
      padding: { left: padLeft, right: padRight, top: 0, bottom: 0 }, alignItems: "CENTER"
    },
    behaviors: [{ id: "strata.backdrop", action: action("state.setFromEvent", name: "onLight") }]
  ) {
    Slot(
      name: "content",
      style: GlassNone,
      layout: { kind: "ROW", width: "content", height: "content", gap: gap, alignItems: "CENTER" }
    )
  }
}

// A capsule button. `look` is "regular", "accent" or "inset". Accent glass carries its own colour
// and keeps light ink whatever is behind it; the other two follow their backdrop.
component GlassButton(key: key, label: string, activate: action, look: string = "regular", icon: string = "") {
  state onLight = false;
  Panel(
    key: key,
    style: style(
      look == "accent" ? GlassAccent : look == "inset" ? GlassInset : GlassControl,
      radius: 999,
      hoverOverlay: #FFFFFF1C,
      activeOverlay: #FFFFFF30,
      focusRing: { width: 2, color: #FFFFFF99 },
      tone: look != "accent" && onLight ? 1 : 0
    ),
    animateChanges: { properties: ["tone"], policy: "standard" },
    layout: {
      kind: "ROW", width: "content", height: 44,
      padding: { horizontal: 20, vertical: 0 }, gap: 8,
      alignItems: "CENTER", justifyContent: "CENTER"
    },
    motions: [{ id: "glass.button.press", interaction: "PRESSED", animation: GlassPress }],
    behaviors: [
      { id: "strata.focusable" },
      { id: "strata.hoverable" },
      { id: "strata.activate", action: activate },
      {
        id: "strata.backdrop", enabled: look != "accent",
        action: action("state.setFromEvent", name: "onLight")
      }
    ],
    semantics: { role: "BUTTON", label: label }
  ) {
    if icon != "" { GlassIcon(name: icon, size: 18) }
    Text(text: label, style: GlassLabel, maxLines: 1)
  }
}

// A round icon button. `lit` shows the control in its on state: bright glass with dark ink, which
// it keeps over any backdrop. Unlit, it follows its backdrop.
component GlassIconButton(
  key: key,
  icon: string,
  label: string,
  activate: action,
  size: number = 44,
  lit: boolean = false,
  look: string = "regular"
) {
  state onLight = false;
  Panel(
    key: key,
    style: style(
      lit ? GlassLit : look == "inset" ? GlassInset : GlassControl,
      radius: 999,
      hoverOverlay: #FFFFFF1C,
      activeOverlay: #FFFFFF30,
      focusRing: { width: 2, color: #FFFFFF99 },
      tone: !lit && onLight ? 1 : 0
    ),
    animateChanges: { properties: ["tone"], policy: "standard" },
    layout: { kind: "ROW", width: size, height: size, alignItems: "CENTER", justifyContent: "CENTER" },
    motions: [{ id: "glass.icon.press", interaction: "PRESSED", animation: GlassPress }],
    behaviors: [
      { id: "strata.focusable" },
      { id: "strata.hoverable" },
      { id: "strata.activate", action: activate },
      { id: "strata.backdrop", enabled: !lit, action: action("state.setFromEvent", name: "onLight") }
    ],
    semantics: { role: "BUTTON", label: label }
  ) {
    GlassIcon(name: icon, size: size * 0.46, ink: lit ? #0B1220F2 : #FFFFFFF2)
  }
}

// Switch: a well that fills with colour, and a droplet that crosses it.
component GlassSwitchSkin(key: key, label: string, description: string, control: toggleState) {
  Panel(
    key: key,
    style: style(GlassWell, background: control.checked ? #30D158F2 : #00000042),
    animateChanges: { properties: ["background"], policy: "standard" },
    layout: { kind: "PANEL", width: 64, height: 30 }
  ) {
    Panel(
      style: GlassDroplet,
      animateChanges: { properties: ["placementX"], policy: "standard" },
      motions: [{ id: "glass.switch.grab", target: control.pressed, animation: GlassGrab }],
      layout: { width: 38, height: 24, placement: { x: control.checked ? 23 : 3, y: 3 } }
    )
  }
}

// `change` receives the requested value as its event: pass
// action("state.setFromEvent", name: "<your state>").
component GlassSwitch(key: key, label: string, checked: boolean, change: action) {
  Toggle(
    key: key,
    label: label,
    checked: checked,
    onChange: change,
    presentationTemplate: GlassSwitchSkin,
    layout: { width: 64, height: 30 }
  )
}

// Slider: a well, a bright fill, and a droplet riding the join between them.
component GlassSliderSkin(key: key, control: sliderState) {
  Panel(key: key, style: GlassNone, layout: { kind: "PANEL", width: { weight: 1 }, height: 30 }) {
    Panel(style: GlassWell, layout: { width: { weight: 1 }, height: 8, placement: { x: 0, y: 11 } })
    Panel(
      style: { background: #FFFFFFEB, border: null, radius: 999 },
      layout: { width: { fraction: control.fraction }, minWidth: 8, height: 8, placement: { x: 0, y: 11 } }
    )
    Panel(
      style: GlassDroplet,
      motions: [{ id: "glass.slider.grab", target: control.pressed, animation: GlassGrab }],
      layout: {
        width: 38, height: 24,
        placement: { x: { fraction: control.fraction }, anchorX: control.fraction, y: 3 }
      }
    )
  }
}

component GlassSlider(
  key: key,
  value: number,
  change: action,
  min: number = 0,
  max: number = 100,
  step: number = 1
) {
  Slider(
    key: key,
    min: min,
    max: max,
    step: step,
    value: value,
    onChange: change,
    presentationTemplate: GlassSliderSkin,
    layout: { width: { weight: 1 }, height: 30 }
  )
}

// One cell of a segmented control or tab bar. The selection lens is drawn by the owner; a segment
// is only its hit target and its ink.
component GlassSegment(key: key, label: string, icon: string, activate: action) {
  Panel(
    key: key,
    style: style(GlassNone, radius: 999, focusRing: { width: 2, color: #FFFFFF99 }),
    layout: {
      kind: "COLUMN", width: { weight: 1 }, height: { weight: 1 }, gap: 3,
      alignItems: "CENTER", justifyContent: "CENTER"
    },
    behaviors: [
      { id: "strata.focusable" },
      { id: "strata.hoverable" },
      { id: "strata.activate", action: activate }
    ],
    semantics: { role: "TAB", label: label }
  ) {
    if icon != "" { GlassIcon(name: icon, size: 21) }
    Text(text: label, style: icon != "" ? GlassOverline : GlassLabel, maxLines: 1)
  }
}

// The lens that marks the selected cell. It slides between cells as `index` changes.
component GlassSelection(index: number, count: number, inset: number = 4) {
  Panel(
    style: GlassNone,
    layout: { kind: "PANEL", width: { weight: 1 }, height: { weight: 1 }, padding: inset }
  ) {
    Panel(
      style: GlassDroplet,
      animateChanges: { properties: ["placementX"], policy: "standard" },
      layout: {
        width: { fraction: 1 / count },
        height: { weight: 1 },
        placement: { x: { fraction: index / count }, y: 0 }
      }
    )
  }
}
