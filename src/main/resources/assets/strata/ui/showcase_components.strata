// Complete .strata-first showcase. Components own presentation and local state; the `demo.*`
// binding/action bridge is reserved for native effects and observable host data.

style Transparent {
  background: null;
  border: null;
}

style Root extends Transparent {
  kind: "OVERLAY";
  width: { weight: 1 };
  height: { weight: 1 };
}

style ContentRoot extends Transparent {
  kind: "COLUMN";
  width: { weight: 1 };
  height: { weight: 1 };
}

style Header {
  kind: "ROW";
  width: { weight: 1 };
  height: 58;
  padding: { horizontal: 14, vertical: 9 };
  gap: 14;
  alignItems: "CENTER";
}

style BodyRow extends Transparent {
  kind: "ROW";
  width: { weight: 1 };
  height: { weight: 1 };
  padding: 12;
  gap: 12;
}

style BodyColumn extends Transparent {
  kind: "COLUMN";
  width: { weight: 1 };
  height: { weight: 1 };
  padding: 12;
  gap: 12;
}

style PageScroll {
  kind: "SCROLL";
  width: { weight: 1 };
  height: { weight: 1 };
}

style PageHost extends Transparent {
  kind: "OVERLAY";
  width: { weight: 1 };
  height: { weight: 1 };
  clip: true;
}

style PageColumn extends Transparent {
  kind: "COLUMN";
  width: { weight: 1 };
  height: "content";
  gap: 11;
}

style GlassTriggerStyle {
  kind: "ROW";
  width: 240;
  height: 38;
  padding: { horizontal: 12, vertical: 8 };
  gap: 8;
  alignItems: "CENTER";
  radius: 10;
  background: null;
  border: null;
  focusRing: { width: 1, color: #C9E8FF34 };
  effect: effect(
    "demo:optic-glass",
    blurRadius: 14,
    downsample: 2,
    refraction: 1.0,
    tint: #34373C14,
    saturation: 0.82,
    highlight: 0.82,
    noise: 0.1,
    transparency: 0.82,
    thickness: 0.95,
    metallic: 0.82,
    edgeContrast: 1.07,
    contrast: 0.88,
    luminosity: 1.02
  );
}

style GlassPopupStyle {
  kind: "COLUMN";
  width: 240;
  height: "content";
  padding: 6;
  gap: 3;
  radius: 14;
  background: null;
  border: null;
  anchorSide: "BOTTOM";
  anchorAlign: "START";
  anchorGap: 7;
  anchorFlip: true;
  anchorShift: true;
  effect: effect(
    "demo:optic-glass",
    blurRadius: 16,
    downsample: 2,
    refraction: 1.2,
    tint: #3432361A,
    saturation: 0.80,
    highlight: 0.84,
    noise: 0.1,
    transparency: 0.74,
    thickness: 1.15,
    metallic: 0.82,
    edgeContrast: 1.12,
    contrast: 0.86,
    luminosity: 1.0
  );
}

style GlassItemStyle extends Transparent {
  kind: "ROW";
  width: { weight: 1 };
  height: 36;
  padding: { horizontal: 11, vertical: 8 };
  gap: 9;
  alignItems: "CENTER";
  radius: 10;
  animateChanges: { properties: ["background", "border"], policy: "fast" };
}

style GlassItemSelected extends GlassItemStyle {
  background: #F0ECE60E;
  border: null;
  effect: effect(
    "demo:optic-glass",
    blurRadius: 10,
    downsample: 2,
    refraction: 0.85,
    tint: #6E70760E,
    saturation: 0.82,
    highlight: 0.55,
    noise: 0.09,
    transparency: 0.76,
    thickness: 0.8,
    metallic: 0.55,
    edgeContrast: 0.94,
    contrast: 0.90,
    luminosity: 1.02
  );
}

style GlassItemActive extends GlassItemStyle {
  background: #F2EEE818;
  border: null;
  effect: effect(
    "demo:optic-glass",
    blurRadius: 12,
    downsample: 2,
    refraction: 0.9,
    tint: #888A9014,
    saturation: 0.84,
    highlight: 0.64,
    noise: 0.09,
    transparency: 0.84,
    thickness: 0.8,
    metallic: 0.60,
    edgeContrast: 1.02,
    contrast: 0.90,
    luminosity: 1.02
  );
}

style GlassItemMarker extends Transparent {
  width: 8;
  height: 8;
  radius: 4;
}

style GlassItemMarkerSelected extends GlassItemMarker {
  background: #EAF8FFFF;
  border: { width: 1, color: #FFFFFFA0 };
}

style GlassChevron extends Transparent {
  width: 14;
  height: 14;
}

style GlassTooltipStyle {
  kind: "PANEL";
  width: "content";
  height: "content";
  padding: { horizontal: 10, vertical: 7 };
  radius: 9;
  background: null;
  border: null;
  anchorSide: "TOP";
  anchorAlign: "CENTER";
  anchorGap: 8;
  effect: effect(
    "demo:optic-glass",
    blurRadius: 12,
    downsample: 2,
    refraction: 1.0,
    tint: #34383E18,
    saturation: 0.82,
    highlight: 0.78,
    noise: 0.09,
    transparency: 0.78,
    thickness: 0.9,
    metallic: 0.78,
    edgeContrast: 1.07,
    contrast: 0.88,
    luminosity: 1.02
  );
}

style EffectFixtureRoot extends Transparent {
  kind: "OVERLAY";
  width: { weight: 1 };
  height: { weight: 1 };
  background: #030511FF;
}

style EffectWallpaper {
  width: { weight: 1 };
  height: { weight: 1 };
  background: #050819FF;
}

style EffectContent {
  kind: "ROW";
  width: 240;
  height: 58;
  padding: 10;
  radius: 12;
  background: #101A2ECC;
  gap: 8;
}

style EffectGallery extends Transparent {
  kind: "COLUMN";
  width: { weight: 1 };
  height: { weight: 1 };
  padding: 38;
  gap: 18;
}

style EffectDemoRow extends Transparent {
  kind: "ROW";
  width: { weight: 1 };
  height: "content";
  gap: 16;
  alignItems: "START";
}

style EffectControlDemo extends Transparent {
  kind: "COLUMN";
  width: 250;
  height: 124;
  gap: 12;
}

style EffectDemoCard {
  kind: "COLUMN";
  width: { weight: 1 };
  height: 124;
  padding: 16;
  gap: 8;
  radius: 20;
  background: #08101CBD;
  border: { width: 1, color: #C8E2FF52 };
}

style LiquidDemoCard extends EffectDemoCard {
  radius: 62;
  background: null;
  border: null;
  effect: effect(
    "demo:optic-glass",
    blurRadius: 16,
    downsample: 2,
    refraction: 1.35,
    tint: #34383E08,
    saturation: 0.96,
    highlight: 0.96,
    noise: 0.1,
    transparency: 0.90,
    thickness: 1.0,
    metallic: 0.88,
    edgeContrast: 1.12,
    contrast: 0.94,
    luminosity: 1.02
  );
}

style FrostedDemoCard extends EffectDemoCard {
  background: #D4E9FF24;
  effect: effect("demo:frosted-backdrop", radius: 14, downsample: 2);
}

style PrismDemoCard extends EffectDemoCard {
  effect: effect("demo:content-prism", strength: 5);
}

style SoftContentDemoCard extends EffectDemoCard {
  effect: effect("demo:soft-content", radius: 6, downsample: 1);
}

style RoundedGlassDemoCard extends LiquidDemoCard {
  radius: 46;
}

style RefractionDiagnosticLayout extends Transparent {
  kind: "COLUMN";
  width: { weight: 1 };
  height: { weight: 1 };
  padding: 42;
  gap: 28;
  alignItems: "CENTER";
}

style RefractionDiagnosticCard extends LiquidDemoCard {
  width: 520;
  height: 230;
  padding: 0;
  radius: 56;
}

style RefractionDiagnosticPill extends LiquidDemoCard {
  width: 520;
  height: 92;
  padding: 0;
  radius: 999;
}

// Universality lab: the same glass over black, over white, over saturated hue, and over a
// high-frequency stripe band, all in one frame.
style LabLayout extends Transparent {
  kind: "COLUMN";
  width: { weight: 1 };
  height: { weight: 1 };
  padding: { horizontal: 24, vertical: 22 };
  gap: 16;
  alignItems: "CENTER";
}

style LabRow extends Transparent {
  kind: "ROW";
  width: { weight: 1 };
  height: "content";
  gap: 16;
  alignItems: "CENTER";
  justifyContent: "CENTER";
}

style LabPill extends LiquidDemoCard {
  kind: "ROW";
  width: 190;
  height: 46;
  padding: { horizontal: 16, vertical: 0 };
  radius: 999;
  alignItems: "CENTER";
  justifyContent: "CENTER";
}

style LabCircle extends LiquidDemoCard {
  width: 74;
  height: 74;
  padding: 0;
  radius: 999;
}

style LabChip extends LiquidDemoCard {
  kind: "ROW";
  width: 140;
  height: 46;
  padding: { horizontal: 12, vertical: 0 };
  radius: 16;
  alignItems: "CENTER";
  justifyContent: "CENTER";
}

style LabWideCard extends LiquidDemoCard {
  width: { weight: 1 };
  height: 120;
  padding: { horizontal: 20, vertical: 16 };
  gap: 6;
  radius: 30;
}

style LabHalfCard extends LiquidDemoCard {
  width: 300;
  height: 96;
  padding: { horizontal: 18, vertical: 14 };
  gap: 5;
  radius: 26;
}

style LabStripeBar extends LiquidDemoCard {
  kind: "ROW";
  width: { weight: 1 };
  height: 62;
  padding: { horizontal: 20, vertical: 0 };
  radius: 999;
  alignItems: "CENTER";
}

style DensityBackdrop extends Transparent {
  kind: "ROW";
  width: { weight: 1 };
  height: { weight: 1 };
}

style DensityCodePane {
  kind: "COLUMN";
  width: 360;
  height: { weight: 1 };
  padding: { horizontal: 18, vertical: 24 };
  gap: 7;
  background: #090D14FF;
  border: null;
}

style DensityCalmPane {
  width: { weight: 1 };
  height: { weight: 1 };
  background: #182841FF;
  border: null;
}

style DensityCodeText {
  font: "strata:fonts/mono";
  pixelSize: 12;
  color: #DCE7F2E8;
  width: { weight: 1 };
  height: "content";
  maxLines: 1;
  overflow: "CLIP";
}

style DensityCodeMuted extends DensityCodeText {
  color: #7E91A6D8;
}

style DensityCodeAccent extends DensityCodeText {
  color: #7DDAFFFF;
}

style DensityGlassPlacement extends Transparent {
  kind: "COLUMN";
  width: { weight: 1 };
  height: { weight: 1 };
  padding: { horizontal: 100, vertical: 72 };
  gap: 28;
  alignItems: "CENTER";
}

style DensityDiagnosticCard extends LiquidDemoCard {
  width: 520;
  height: 230;
  padding: 22;
  radius: 56;
}

style DensityDiagnosticPill extends LiquidDemoCard {
  width: 220;
  height: 44;
  padding: { horizontal: 18, vertical: 0 };
  radius: 999;
  justifyContent: "CENTER";
}

style CardStyle {
  kind: "COLUMN";
  width: { weight: 1 };
  height: "content";
  padding: 13;
  gap: 8;
  radius: 7;
  border: { width: 1, color: #61708ACC };
}

style ContentSlot extends Transparent {
  kind: "COLUMN";
  width: { weight: 1 };
  height: "content";
  gap: 8;
}

style SpotCard {
  kind: "COLUMN";
  width: { weight: 1 };
  height: 120;
  padding: 16;
  gap: 6;
  radius: 14;
  background: #11161FFF;
  border: { width: 1, color: #2A3342FF };
}

style TiltSurface {
  kind: "COLUMN";
  width: { weight: 1 };
  height: 190;
  padding: 18;
  gap: 8;
  radius: 18;
  justifyContent: "END";
  border: { width: 1, color: #FFFFFF2A };
}

style CarouselCard {
  kind: "COLUMN";
  width: 150;
  height: 190;
  padding: 14;
  radius: 16;
  justifyContent: "END";
  border: { width: 1, color: #FFFFFF30 };
}

style RaceTrack extends Transparent {
  kind: "ROW";
  width: { weight: 1 };
  height: 34;
  gap: 10;
  alignItems: "CENTER";
}

style RaceDot {
  width: 26;
  height: 26;
  radius: 13;
}

style CardTitle {
  font: "strata:fonts/default-medium";
  pixelSize: 17;
  color: #F4F7FBFF;
}

style CardNote {
  pixelSize: 12;
  color: #9AA7BAFF;
}

style ShapeFrame extends Transparent {
  kind: "PANEL";
  width: 128;
  height: 128;
  clip: true;
}

style ShapeFill {
  kind: "COLUMN";
  width: { weight: 1 };
  height: { weight: 1 };
  alignItems: "CENTER";
  justifyContent: "CENTER";
  background: {
    kind: "linear", angle: 135,
    stops: [ { color: #7C6BFFFF }, { color: #39C0A8FF } ]
  };
  border: null;
}

style ShapeLabel {
  font: "strata:fonts/default-medium";
  pixelSize: 14;
  color: #FFFFFFFF;
}

style HeroText {
  font: "strata:fonts/default-medium";
  pixelSize: 54;
  color: #F4F7FBFF;
}

style FadeList {
  kind: "SCROLL";
  width: { weight: 1 };
  height: 230;
  clip: true;
}

style FadeRow {
  kind: "ROW";
  width: { weight: 1 };
  height: 34;
  padding: { horizontal: 12 };
  alignItems: "CENTER";
  radius: 8;
  background: #1A2230FF;
  border: null;
}

animation SlowSpin { duration: 12s; repeat: "forever"; easing: "linear"; from { rotate: 0 } to { rotate: 360 } }

style MenuField extends Transparent {
  kind: "COLUMN";
  width: { weight: 1 };
  height: { weight: 1 };
  alignItems: "CENTER";
  justifyContent: "CENTER";
  gap: 14;
}

style MenuButtons extends Transparent {
  kind: "COLUMN";
  width: 260;
  height: "content";
  gap: 9;
  padding: { top: 18 };
}

style MenuTitle {
  font: "strata:fonts/default-medium";
  pixelSize: 64;
  color: #F4F7FBFF;
}

style MenuSubtitle {
  pixelSize: 15;
  color: #8FA6BAFF;
}

style ActionRow extends Transparent {
  kind: "ROW";
  width: { weight: 1 };
  height: "content";
  gap: 7;
  wrap: true;
}

style TitleText {
  font: "strata:fonts/default-medium";
  pixelSize: 18;
  color: #F4F7FBFF;
}

style SectionText {
  font: "strata:fonts/default-medium";
  pixelSize: 14;
  color: #E8EDF5FF;
}

style TelemetryText {
  font: "strata:fonts/mono";
  pixelSize: 12;
}

style SquareCheckbox {
  radius: 2;
  indicatorSize: 17;
  indicatorInset: 4;
  track: #202735FF;
  fill: #5EC9A8FF;
  focusRing: { width: 2, color: #74C2FFFF };
}

style MaterialBoolean {
  trackWidth: 42;
  trackHeight: 24;
  trackRadius: 12;
  thumbSize: 20;
  thumbRadius: 10;
  indicatorInset: 4;
  track: #5F6368FF;
  thumb: #F1F3F4FF;
  focusRing: { width: 2, color: #8AB4F8FF };
  indicatorPosition: 0;
  animateChanges: { properties: ["track", "thumb", "indicatorPosition"], policy: "standard" };
}

style MaterialBooleanOn extends MaterialBoolean {
  track: #1A73E8FF;
  thumb: #FFFFFFFF;
  indicatorPosition: 1;
}

animation CanvasClock {
  from { opacity: 1 }
  to { opacity: 1 }
  duration: 9000ms;
  easing: "linear";
  repeat: "forever";
}

animation SpinForever {
  from { rotate: 0 }
  to { rotate: 360 }
  duration: 4000ms;
  easing: "linear";
  repeat: "forever";
}

animation SpinBackward {
  from { rotate: 360 }
  to { rotate: 0 }
  duration: 1800ms;
  easing: "linear";
  repeat: "forever";
}

animation Breathe {
  from { scale: 0.84, opacity: 0.6 }
  to { scale: 1.04, opacity: 1 }
  duration: 1500ms;
  easing: "cubic-in-out";
  repeat: "forever";
  reverse: true;
}

animation ContentMotion {
  from { opacity: 0, translateY: 10 }
  to { opacity: 1, translateY: 0 }
  duration: 180ms;
  easing: "cubic-out";
  fillMode: "FORWARDS";
}

animation ExtensionHoverMotion {
  from { opacity: 0.82 }
  to { opacity: 1 }
  duration: 80ms;
  easing: "cubic-out";
}

animation GlassPopupEnter {
  from { opacity: 0, translateY: -7, scale: 0.975 }
  to { opacity: 1, translateY: 0, scale: 1 }
  duration: 145ms;
  easing: "cubic-out";
  fillMode: "FORWARDS";
}

animation GlassPopupExit {
  from { opacity: 1, translateY: 0, scale: 1 }
  to { opacity: 0, translateY: -5, scale: 0.985 }
  duration: 105ms;
  easing: "cubic-in";
  fillMode: "FORWARDS";
}

component Card(title: string) {
  defaults: { Button: { variant: "compact" } }
  Panel(style: CardStyle, transition: ContentMotion) {
    Slot(name: "header") {
      Text(text: title, style: SectionText, maxLines: 1)
    }
    Slot(name: "content", required: true, style: ContentSlot)
    Slot(name: "footer")
  }
}

component ButtonRow() {
  Panel(style: ActionRow) {
    Slot(name: "content", style: ActionRow)
  }
}

component CompactButton(label: string, buttonKey: key, click: action) {
  Button(key: buttonKey, label: label, variant: "compact", onClick: click)
}

component Pane(label: string) {
  Panel(
    variant: "secondary",
    layout: { kind: "PANEL", width: { weight: 1 }, height: { weight: 1 }, padding: 10 }
  ) {
    Text(text: label, style: TelemetryText)
  }
}

component DataTreeRow(key: key, label: string, expanded: boolean, selected: boolean, loading: boolean) {
  Panel(
    key: key,
    style: Transparent,
    layout: { kind: "ROW", width: { weight: 1 }, height: { weight: 1 }, alignItems: "CENTER", gap: 7 }
  ) {
    Text(text: label, maxLines: 1, overflow: "ELLIPSIS")
  }
}

component AsyncListRow(item: record, key: key, index: number) {
  Text(key: key, text: item.label, maxLines: 1, overflow: "ELLIPSIS")
}

component DataProgressCell(key: key, value: number, selected: boolean) {
  Panel(key: key, style: Transparent, layout: { kind: "COLUMN", width: { weight: 1 }, height: { weight: 1 }, padding: { horizontal: 7, vertical: 3 }, gap: 2 }) {
    Progress(value: value / 100, layout: { width: { weight: 1 }, height: 6 })
    Text(text: format("{0}%", value), style: TelemetryText, maxLines: 1)
  }
}

component DataPinnedNameCell(key: key, value: string, selected: boolean) {
  Button(
    key: key,
    label: value,
    variant: selected ? "primary" : "subtle",
    layout: { width: { weight: 1 }, height: { weight: 1 } },
    onClick: action("demo.data.collection")
  )
}

component DataGridItem(key: key, label: string, selected: boolean) {
  Panel(
    key: key,
    variant: selected ? "primary" : "secondary",
    layout: { kind: "COLUMN", width: { weight: 1 }, height: { weight: 1 }, padding: 8, gap: 5, alignItems: "CENTER" },
    behaviors: [
      {
        id: "strata.drag-source",
        action: action("demo.data.collection"),
        options: { payloadType: "demo.data-grid-item", payload: key, allowedOperations: ["MOVE"] }
      },
      {
        id: "strata.drop-target",
        action: action("demo.data.collection"),
        options: { acceptedTypes: ["demo.data-grid-item"], allowedOperations: ["MOVE"], insertionAxis: "HORIZONTAL" }
      }
    ]
  ) {
    Text(text: "◆", style: SectionText)
    Text(text: label, maxLines: 1, overflow: "ELLIPSIS")
  }
}

component GlassChoiceTrigger(
  key: key,
  label: string,
  enabled: boolean,
  expanded: boolean
) {
  Panel(key: key, style: GlassTriggerStyle, variant: expanded ? "primary" : "secondary") {
    Text(
      text: label,
      layout: { width: { weight: 1 }, height: "content" },
      maxLines: 1,
      overflow: "ELLIPSIS"
    )
    Image(
      image: expanded ? "strata:ui/icons/chevron-up" : "strata:ui/icons/chevron-down",
      tint: #D8E9FFFF,
      style: GlassChevron
    )
  }
}

component GlassPopup(key: key, level: number, expanded: boolean) {
  Panel(
    key: key,
    style: GlassPopupStyle,
    enter: GlassPopupEnter,
    exit: GlassPopupExit
  )
}

component GlassChoiceItem(
  key: key,
  id: string,
  label: string,
  index: number,
  level: number,
  enabled: boolean,
  selected: boolean,
  active: boolean,
  checked: boolean,
  separator: boolean,
  hasChildren: boolean,
  shortcut: string
) {
  Panel(
    key: key,
    style: active ? GlassItemActive : selected ? GlassItemSelected : GlassItemStyle,
    semantics: { role: "MENU_ITEM", label: label }
  ) {
    Panel(style: checked || selected ? GlassItemMarkerSelected : GlassItemMarker)
    Text(
      text: separator ? "------------------------" : label,
      layout: { width: { weight: 1 }, height: "content" },
      maxLines: 1,
      overflow: "ELLIPSIS"
    )
    Text(text: shortcut != "" ? shortcut : hasChildren ? ">" : "", style: TelemetryText)
  }
}

component GlassTooltip(key: key, text: string) {
  Panel(key: key, style: GlassTooltipStyle) {
    Text(text: text, style: TelemetryText, maxLines: 2, wrapMode: "WORD")
  }
}

component GlassEffectFixture() {
  Panel(style: EffectFixtureRoot) {
    Panel(
      style: EffectWallpaper,
      material: material("demo:color-bath")
    )
    Panel(style: EffectGallery) {
      Text(text: "Authored effect gallery", style: SectionText)
      Panel(style: EffectDemoRow) {
        Panel(style: LiquidDemoCard) {
          Text(text: "OPTIC GLASS", style: SectionText)
          Text(
            text: "Blur + refraction + tint over live backdrop",
            style: TelemetryText,
            wrapMode: "WORD",
            maxLines: 2
          )
        }
        Panel(style: FrostedDemoCard) {
          Text(text: "FROSTED BACKDROP", style: SectionText)
          Text(
            text: "Typed blur-only program; portable and GPU paths agree",
            style: TelemetryText,
            wrapMode: "WORD",
            maxLines: 2
          )
        }
        Panel(style: PrismDemoCard) {
          Text(text: "CONTENT PRISM", style: SectionText)
          Text(
            text: "The subtree is isolated before its authored shader runs",
            style: TelemetryText,
            wrapMode: "WORD",
            maxLines: 2
          )
        }
      }
      Panel(style: EffectDemoRow) {
        Panel(style: EffectControlDemo) {
          Text(text: "ANCHORED GLASS CONTROL", style: SectionText)
          Text(text: "Authored trigger, popup, and rows", style: TelemetryText)
          Select(
            key: "effect.fixture.select",
            defaultExpanded: true,
            options: [
              { id: "glass", label: "Optic glass" },
              { id: "prism", label: "Content prism" },
              { id: "software", label: "Deterministic fallback" }
            ],
            triggerTemplate: GlassChoiceTrigger,
            popupTemplate: GlassPopup,
            itemTemplate: GlassChoiceItem
          )
        }
        Panel(style: RoundedGlassDemoCard) {
          Text(text: "ROUNDED MASK", style: SectionText)
          Text(
            text: "One shared radius drives shader edge, border, and final composite",
            style: TelemetryText,
            wrapMode: "WORD",
            maxLines: 3
          )
        }
        Panel(style: SoftContentDemoCard) {
          Text(text: "SOFT CONTENT", style: SectionText)
          Text(
            text: "A CONTENT blur filters only this card's subtree",
            style: TelemetryText,
            wrapMode: "WORD",
            maxLines: 3
          )
        }
      }
    }
  }
}

component GlassRefractionFixture() {
  Panel(style: EffectFixtureRoot) {
    Panel(
      style: EffectWallpaper,
      material: material("demo:refraction-grid")
    )
    Panel(style: RefractionDiagnosticLayout) {
      Text(text: "PERMANENT REFRACTION GRID", style: SectionText)
      Panel(style: RefractionDiagnosticCard)
      Panel(style: RefractionDiagnosticPill)
    }
  }
}

