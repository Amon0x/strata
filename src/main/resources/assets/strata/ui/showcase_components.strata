        Text(text: "[1/8] compiling ui/render.cpp", style: DensityCodeMuted)
        Text(text: "[2/8] linking strata_core.lib", style: DensityCodeMuted)
        Text(text: "frame 1842  gpu 3.71ms  cpu 1.26ms", style: DensityCodeText)
        Text(text: "effect optic-glass refresh 240Hz", style: DensityCodeText)
        Text(text: "backdrop epoch=948 geometry=stable", style: DensityCodeMuted)
        Text(text: "if (refractionField > 0.0) {", style: DensityCodeAccent)
        Text(text: "  sampleBackdrop(refractedUv);", style: DensityCodeText)
        Text(text: "  composite(surface, transmission);", style: DensityCodeText)
        Text(text: "}", style: DensityCodeAccent)
        Text(text: "INFO popup anchored BOTTOM_START", style: DensityCodeMuted)
        Text(text: "WARN cache miss layer=glass.menu", style: DensityCodeText)
        Text(text: "PASS strata.headless.effects 1.42s", style: DensityCodeAccent)
        Text(text: "$ _", style: DensityCodeText)
      }
      Panel(
        style: DensityCalmPane,
        material: material("demo:aurora", intensity: 0.28, tint: #6278A8FF)
      )
