// F2 Control Deck: grounded dark chrome shaped by restrained optic-glass lenses.

style Clear { background: null; border: null; }

style DeckRoot {
  kind: "OVERLAY";
  width: { weight: 1 };
  height: { weight: 1 };
  padding: 30;
  alignItems: "CENTER";
  justifyContent: "CENTER";
  background: #050819FF;
  border: null;
}

style DeckShell {
  kind: "COLUMN";
  width: { weight: 1 };
  height: { weight: 1 };
  maxWidth: 1080;
  maxHeight: 690;
  radius: 22;
  clip: true;
  background: null;
  border: null;
  effect: effect(
    "deck:optic-glass",
    blurRadius: 18,
    downsample: 2,
    refraction: 1.1,
    tint: #151B2218,
    saturation: 0.82,
    highlight: 0.65,
    noise: 0.1,
    transparency: 0.66,
    thickness: 1.1,
    metallic: 0.82,
    edgeContrast: 0.94,
    contrast: 0.88,
    luminosity: 0.98
  );
}

style DeckHeader {
  kind: "ROW";
  width: { weight: 1 };
  height: 61;
  padding: { horizontal: 20, vertical: 14 };
  gap: 12;
  alignItems: "CENTER";
  radius: 0;
  background: #11171D70;
  border: null;
}

style DeckHeaderRule { width: { weight: 1 }; height: 1; background: #DCE4E91A; border: null; }
style DeckLensGlint {
  width: { weight: 1 };
  height: 1;
  background: {
    kind: "linear",
    angle: 90,
    stops: [
      { color: #F4FAFF00 },
      { color: #EEF8FF42 },
      { color: #F4FAFF00 }
    ]
  };
  border: null;
}

style DeckTitle { font: "strata:fonts/default-medium"; pixelSize: 23; color: #EFF2F4FF; }
style DeckScope { font: "strata:fonts/mono"; pixelSize: 12; color: #9FB3C0FF; }
style DeckHint { font: "strata:fonts/mono"; pixelSize: 11; color: #737F88FF; }

style DeckBody extends Clear {
  kind: "ROW";
  width: { weight: 1 };
  height: { weight: 1 };
}

style DeckSidebar {
  kind: "COLUMN";
  width: 190;
  height: { weight: 1 };
  padding: { horizontal: 12, vertical: 16 };
  gap: 8;
  background: #090D12B8;
  border: { width: 1, color: #D9E3EA17 };
}

style CategoryItem {
  kind: "ROW";
  width: { weight: 1 };
  height: 48;
  padding: { horizontal: 12, vertical: 9 };
  gap: 11;
  alignItems: "CENTER";
  radius: 8;
  background: #C5D4DF00;
  border: { width: 1, color: #D7E1E800 };
  hoverOverlay: #C3D3DF0D;
  activeOverlay: #C3D3DF16;
  animateChanges: { properties: ["background", "border"], policy: "fast" };
}

style CategoryItemSelected extends CategoryItem {
  background: #AFC0CC18;
  border: { width: 1, color: #D8E2E92A };
}

style CategoryMark {
  kind: "PANEL";
  width: 28;
  height: 28;
  radius: 8;
  alignItems: "CENTER";
  justifyContent: "CENTER";
  background: #141A20B8;
  border: { width: 1, color: #D5DEE524 };
}
style CategoryMarkSelected extends CategoryMark {
  background: #A7BBC82B;
  border: { width: 1, color: #E0E7EC52 };
}
style CategoryIconDraw extends Clear { width: 18; height: 18; }
style CategoryLabel { pixelSize: 14; color: #929CA4FF; }
style CategoryLabelSelected { font: "strata:fonts/default-medium"; pixelSize: 14; color: #E2E9EDFF; }

style SidebarFoot extends Clear {
  kind: "COLUMN";
  width: { weight: 1 };
  height: "content";
  padding: 10;
  gap: 5;
}
style SidebarFootTitle { font: "strata:fonts/default-medium"; pixelSize: 12; color: #C8D0D5FF; }
style SidebarFootCopy { pixelSize: 11; color: #707B83FF; }

style ContentHost {
  kind: "COLUMN";
  width: { weight: 1 };
  height: { weight: 1 };
  padding: 18;
  gap: 15;
  background: #10151AB5;
  border: null;
}

style ContentHeader extends Clear {
  kind: "ROW";
  width: { weight: 1 };
  height: 50;
  gap: 12;
  alignItems: "CENTER";
}
style ContentTitle { font: "strata:fonts/default-medium"; pixelSize: 18; color: #E7EBEEFF; }
style ContentSubtitle { pixelSize: 12; color: #7E8991FF; }

style SegmentRail extends Clear {
  kind: "ROW";
  width: "content";
  height: 42;
  gap: 8;
}
style Segment {
  kind: "ROW";
  width: 138;
  height: 42;
  padding: { horizontal: 16, vertical: 10 };
  alignItems: "CENTER";
  justifyContent: "CENTER";
  radius: 7;
  background: #141A20B8;
  border: { width: 1, color: #D3DDE31B };
}
style SegmentSelected extends Segment {
  background: #AABCC817;
  border: { width: 1, color: #DAE3E92E };
}
style SegmentText { font: "strata:fonts/default-medium"; pixelSize: 13; color: #9AA4ABFF; }
style SegmentTextSelected { font: "strata:fonts/default-medium"; pixelSize: 13; color: #E1E8ECFF; }

style DeckScroll {
  kind: "SCROLL";
  width: { weight: 1 };
  height: { weight: 1 };
  background: null;
  border: null;
}
style SettingsStack extends Clear {
  kind: "COLUMN";
  width: { weight: 1 };
  height: "content";
  gap: 17;
  padding: { right: 8, bottom: 8 };
}

style SectionBlock extends Clear {
  kind: "COLUMN";
  width: { weight: 1 };
  height: "content";
  gap: 9;
}
style SectionHeadingRow extends Clear {
  kind: "ROW";
  width: { weight: 1 };
  height: 28;
  gap: 12;
  alignItems: "CENTER";
}
style SectionHeading { font: "strata:fonts/default-medium"; pixelSize: 12; color: #B7C0C6FF; }
style SectionRule { kind: "PANEL"; width: { weight: 1 }; height: 1; background: #D7E0E51A; border: null; }

style SettingsCard {
  kind: "COLUMN";
  width: { weight: 1 };
  height: "content";
  padding: 14;
  gap: 9;
  radius: 12;
  background: {
    kind: "linear",
    angle: 150,
    stops: [
      { color: #192028C2 },
      { color: #11161BCF }
    ]
  };
  border: { width: 1, color: #D9E2E720 };
}

style CheckRow extends Clear {
  kind: "ROW";
  width: { weight: 1 };
  height: 40;
  gap: 9;
  alignItems: "CENTER";
}
style CheckText { pixelSize: 14; color: #C2C9CEFF; }
style CheckTextHover { pixelSize: 14; color: #EDF1F3FF; }
style CheckMeta { pixelSize: 11; color: #727D85FF; }
style CheckFocusShell {
  kind: "PANEL";
  width: 26;
  height: 26;
  radius: 6;
  alignItems: "CENTER";
  justifyContent: "CENTER";
  background: #A8BFCE00;
  border: { width: 1, color: #A8BFCE00 };
  animateChanges: { properties: ["background", "border"], policy: "fast" };
}
style CheckFocusShellOn extends CheckFocusShell {
  background: #A8BFCE14;
  border: { width: 1, color: #B8CCD878 };
}
style AuthoredCheck {
  kind: "PANEL";
  width: 20;
  height: 20;
  radius: 4;
  alignItems: "CENTER";
  justifyContent: "CENTER";
  background: #171D22FF;
  border: { width: 1, color: #56636CFF };
  animateChanges: { properties: ["background", "border"], policy: "fast" };
}
style AuthoredCheckHover extends AuthoredCheck {
  background: #222A30FF;
  border: { width: 1, color: #8FA6B5FF };
}
style AuthoredCheckPressed extends AuthoredCheck {
  background: #2A353DFF;
  border: { width: 1, color: #A6BAC7FF };
}
style AuthoredCheckOn extends AuthoredCheck {
  background: #6E899BFF;
  border: { width: 1, color: #AFC2CEFF };
}
style AuthoredCheckOnHover extends AuthoredCheck {
  background: #7D97A8FF;
  border: { width: 1, color: #CBD8E0FF };
}
style AuthoredCheckOnPressed extends AuthoredCheck {
  background: #5D7687FF;
  border: { width: 1, color: #A8BAC6FF };
}

style ChoiceRow extends Clear {
  kind: "ROW";
  width: { weight: 1 };
  height: 54;
  gap: 16;
  alignItems: "CENTER";
}
style ChoiceCopy extends Clear {
  kind: "COLUMN";
  width: { weight: 1 };
  height: "content";
  gap: 3;
}
style ChoiceLabel { font: "strata:fonts/default-medium"; pixelSize: 13; color: #C5CCD1FF; }
style ChoiceDescription { pixelSize: 11; color: #727D85FF; }

style DeckSelectTrigger {
  kind: "ROW";
  width: 340;
  height: 44;
  padding: { horizontal: 14, vertical: 10 };
  gap: 10;
  alignItems: "CENTER";
  radius: 10;
  background: #151B21D4;
  border: { width: 1, color: #D6E0E625 };
  focusRing: { width: 1, color: #AEC3D078 };
}
style DeckSelectPopup {
  kind: "COLUMN";
  width: 340;
  height: "content";
  padding: 6;
  gap: 3;
  radius: 13;
  background: null;
  border: null;
  anchorSide: "BOTTOM";
  anchorAlign: "START";
  anchorGap: 5;
  anchorFlip: true;
  anchorShift: true;
  effect: effect(
    "deck:optic-glass",
    blurRadius: 14,
    downsample: 2,
    refraction: 1.0,
    tint: #53616B38,
    saturation: 0.76,
    highlight: 0.56,
    noise: 0.08,
    transparency: 0.72,
    thickness: 1.0,
    metallic: 0.82,
    edgeContrast: 1.04,
    contrast: 0.88,
    luminosity: 1.0
  );
}
style DeckSelectItem {
  kind: "ROW";
  width: { weight: 1 };
  height: 38;
  padding: { horizontal: 11, vertical: 9 };
  gap: 9;
  alignItems: "CENTER";
  radius: 6;
  background: #BBCBD700;
  border: { width: 1, color: #DCE4E900 };
  animateChanges: { properties: ["background", "border"], policy: "fast" };
}
style DeckSelectItemSelected extends DeckSelectItem {
  background: #A8BCC919;
  border: { width: 1, color: #D4E0E82C };
}
style DeckSelectItemActive extends DeckSelectItem {
  background: #B7C8D31C;
  border: { width: 1, color: #DCE5EA26 };
}
style DeckSelectItemSelectedActive extends DeckSelectItem {
  background: #AFC2CE2B;
  border: { width: 1, color: #E1E8EC3D };
}
style SelectValue { font: "strata:fonts/default-medium"; pixelSize: 13; color: #E3E8EBFF; }
style SelectMeta { font: "strata:fonts/mono"; pixelSize: 10; color: #7C8992FF; }
style SelectedMark { kind: "PANEL"; width: 6; height: 6; radius: 3; background: #BDD1DEFF; border: null; }
style EmptyMark extends Clear { width: 6; height: 6; }

style StatusCard {
  kind: "ROW";
  width: { weight: 1 };
  height: 58;
  padding: { horizontal: 14, vertical: 12 };
  gap: 11;
  alignItems: "CENTER";
  radius: 11;
  background: #12181DC7;
  border: { width: 1, color: #D8E1E620 };
}
style StatusDot { kind: "PANEL"; width: 8; height: 8; radius: 4; background: #55C869FF; border: null; }
style StatusTitle { font: "strata:fonts/default-medium"; pixelSize: 13; color: #CCD3D7FF; }
style StatusMeta { pixelSize: 11; color: #747F87FF; }

style ProfileGrid extends Clear { kind: "GRID"; width: { weight: 1 }; height: "content"; gap: 10; }
style ProfileCard {
  kind: "COLUMN";
  width: { weight: 1 };
  height: 116;
  padding: 14;
  gap: 8;
  radius: 12;
  background: #141A20C9;
  border: { width: 1, color: #D9E2E720 };
}
style ProfileCardSelected extends ProfileCard { border: { width: 1, color: #C3D3DD48 }; background: #AFC1CC15; }
style ProfileTitle { font: "strata:fonts/default-medium"; pixelSize: 14; color: #D9DFE3FF; }
style ProfileMeta { pixelSize: 11; color: #78838BFF; }
style ProfileBadge {
  kind: "PANEL";
  width: "content";
  height: 20;
  padding: { horizontal: 7, vertical: 3 };
  radius: 5;
  background: #AFC3D01C;
  border: { width: 1, color: #D5E0E72E };
}
style ProfileBadgeText { font: "strata:fonts/mono"; pixelSize: 9; color: #BFD1DDFF; }

animation DeckEnter {
  from { opacity: 0, translateY: 10, scale: 0.985 }
  to { opacity: 1, translateY: 0, scale: 1 }
  duration: 180ms;
  easing: "cubic-out";
  fillMode: "FORWARDS";
}
animation PopupTransition {
  from { opacity: 0, translateY: -4 }
  to { opacity: 1, translateY: 0 }
  duration: 120ms;
  easing: "cubic-out";
  fillMode: "FORWARDS";
}

component CategoryIcon(icon: string, selected: boolean) {
  if icon == "DISPLAY" {
    Draw(style: CategoryIconDraw, shapes: [
      {
        kind: "path",
        commands: "M 0.08 0.50 C 0.22 0.25, 0.39 0.17, 0.50 0.17 C 0.67 0.17, 0.83 0.29, 0.92 0.50 C 0.79 0.75, 0.62 0.83, 0.50 0.83 C 0.33 0.83, 0.17 0.71, 0.08 0.50 Z",
        stroke: selected ? #FFFFFFFF : #A6A9B0FF,
        strokeStyle: { width: 1.5, cap: "round", join: "round" }
      },
      {
        kind: "circle",
        center: { x: 0.50, y: 0.50 },
        radius: 0.15,
        stroke: selected ? #FFFFFFFF : #A6A9B0FF,
        strokeStyle: { width: 1.5 }
      }
    ])
  } else if icon == "INPUT" {
    Draw(style: CategoryIconDraw, shapes: [
      {
        kind: "path",
        commands: "M 0.20 0.10 L 0.82 0.53 L 0.55 0.59 L 0.72 0.87 L 0.57 0.95 L 0.40 0.65 L 0.20 0.84 Z",
        stroke: selected ? #FFFFFFFF : #A6A9B0FF,
        strokeStyle: { width: 1.5, cap: "round", join: "round" }
      }
    ])
  } else if icon == "AUDIO" {
    Draw(style: CategoryIconDraw, shapes: [
      {
        kind: "path",
        commands: "M 0.10 0.39 L 0.32 0.39 L 0.55 0.20 L 0.55 0.80 L 0.32 0.61 L 0.10 0.61 Z",
        stroke: selected ? #FFFFFFFF : #A6A9B0FF,
        strokeStyle: { width: 1.5, cap: "round", join: "round" }
      },
      {
        kind: "arc",
        center: { x: 0.52, y: 0.50 },
        radiusX: 0.23,
        radiusY: 0.23,
        start: -48,
        sweep: 96,
        stroke: selected ? #FFFFFFFF : #A6A9B0FF,
        strokeStyle: { width: 1.5, cap: "round" }
      },
      {
        kind: "arc",
        center: { x: 0.52, y: 0.50 },
        radiusX: 0.39,
        radiusY: 0.39,
        start: -43,
        sweep: 86,
        stroke: selected ? #FFFFFFFF : #A6A9B0FF,
        strokeStyle: { width: 1.5, cap: "round" }
      }
    ])
  } else if icon == "PROFILES" {
    Draw(style: CategoryIconDraw, shapes: [
      {
        kind: "circle",
        center: { x: 0.50, y: 0.31 },
        radius: 0.18,
        stroke: selected ? #FFFFFFFF : #A6A9B0FF,
        strokeStyle: { width: 1.5 }
      },
      {
        kind: "path",
        commands: "M 0.15 0.88 C 0.18 0.65, 0.31 0.55, 0.50 0.55 C 0.69 0.55, 0.82 0.65, 0.85 0.88",
        stroke: selected ? #FFFFFFFF : #A6A9B0FF,
        strokeStyle: { width: 1.5, cap: "round", join: "round" }
      }
    ])
  } else if icon == "ADVANCED" {
    Draw(style: CategoryIconDraw, shapes: [
      {
        kind: "path",
        commands: "M 0.12 0.25 H 0.88 M 0.12 0.50 H 0.88 M 0.12 0.75 H 0.88",
        stroke: selected ? #FFFFFFFF : #A6A9B0FF,
        strokeStyle: { width: 1.5, cap: "round" }
      },
      {
        kind: "circle",
        center: { x: 0.34, y: 0.25 },
        radius: 0.09,
        fill: selected ? #FFFFFFFF : #A6A9B0FF
      },
      {
        kind: "circle",
        center: { x: 0.67, y: 0.50 },
        radius: 0.09,
        fill: selected ? #FFFFFFFF : #A6A9B0FF
      },
      {
        kind: "circle",
        center: { x: 0.45, y: 0.75 },
        radius: 0.09,
        fill: selected ? #FFFFFFFF : #A6A9B0FF
      }
    ])
  } else {
    Draw(style: CategoryIconDraw, shapes: [
      {
        kind: "circle",
        center: { x: 0.50, y: 0.50 },
        radius: 0.39,
        stroke: selected ? #FFFFFFFF : #A6A9B0FF,
        strokeStyle: { width: 1.5 }
      },
      {
        kind: "path",
        commands: "M 0.12 0.50 H 0.88 M 0.50 0.11 C 0.31 0.27, 0.31 0.73, 0.50 0.89 M 0.50 0.11 C 0.69 0.27, 0.69 0.73, 0.50 0.89",
        stroke: selected ? #FFFFFFFF : #A6A9B0FF,
        strokeStyle: { width: 1.5, cap: "round", join: "round" }
      }
    ])
  }
}

component CategoryButton(id: string, icon: string, label: string, selected: boolean, activate: action) {
  Panel(
    key: id,
    style: selected ? CategoryItemSelected : CategoryItem,
    behaviors: [
      { id: "strata.focusable" },
      { id: "strata.hoverable" },
      { id: "strata.activate", action: activate }
    ]
  ) {
    Panel(style: selected ? CategoryMarkSelected : CategoryMark) {
      CategoryIcon(icon: icon, selected: selected)
    }
    Text(
      text: label,
      style: selected ? CategoryLabelSelected : CategoryLabel,
      layout: { width: { weight: 1 }, height: "content" }
    )
  }
}

component SegmentButton(id: string, label: string, selected: boolean, activate: action) {
  Panel(
    key: id,
    style: selected ? SegmentSelected : Segment,
    behaviors: [
      { id: "strata.focusable" },
      { id: "strata.hoverable" },
      { id: "strata.activate", action: activate }
    ]
  ) {
    Text(text: label, style: selected ? SegmentTextSelected : SegmentText)
  }
}

component DeckChoiceTrigger(key: key, label: string, enabled: boolean, expanded: boolean) {
  Panel(key: key, style: DeckSelectTrigger) {
    Text(text: label, style: SelectValue, layout: { width: { weight: 1 }, height: "content" })
    Text(text: expanded ? "⌃" : "⌄", style: SelectMeta)
  }
}

component DeckChoicePopup(key: key, level: number, expanded: boolean) {
  Panel(key: key, style: DeckSelectPopup, transition: PopupTransition)
}

component DeckChoiceItem(
  key: key,
  id: string,
  label: string,
  value: any,
  index: number,
  level: number,
  enabled: boolean,
  selected: boolean,
  active: boolean,
  checked: boolean,
  separator: boolean,
  hasChildren: boolean,
  shortcut: string
) {
  Panel(
    key: key,
    style: active && selected
      ? DeckSelectItemSelectedActive
      : active ? DeckSelectItemActive
      : selected ? DeckSelectItemSelected
      : DeckSelectItem
  ) {
    Panel(style: selected ? SelectedMark : EmptyMark)
    Text(text: label, style: SelectValue, layout: { width: { weight: 1 }, height: "content" })
  }
}

component ChoiceSetting(
  key: key,
  label: string,
  description: string,
  options: selectItems,
  initial: string
) {
  Panel(style: ChoiceRow) {
    Panel(style: ChoiceCopy) {
      Text(text: label, style: ChoiceLabel)
      Text(text: description, style: ChoiceDescription)
    }
    Select(
      key: key,
      options: options,
      defaultSelectedId: initial,
      triggerTemplate: DeckChoiceTrigger,
      popupTemplate: DeckChoicePopup,
      itemTemplate: DeckChoiceItem
    )
  }
}

component DeckCheckboxPresentation(
  key: key,
  label: string,
  description: string,
  control: checkboxState
) {
  Panel(
    key: key,
    style: CheckRow
  ) {
    Panel(style: control.focusVisible ? CheckFocusShellOn : CheckFocusShell) {
      Panel(
        style: control.checked
          ? control.pressed ? AuthoredCheckOnPressed
            : control.hovered ? AuthoredCheckOnHover
            : AuthoredCheckOn
          : control.pressed ? AuthoredCheckPressed
            : control.hovered ? AuthoredCheckHover
            : AuthoredCheck
      ) {
        if control.checked {
          Draw(
            style: Clear,
            layout: { width: 12, height: 12 },
            shapes: [
              {
                kind: "path",
                commands: "M 0.10 0.52 L 0.39 0.80 L 0.91 0.19",
                stroke: #FFFFFFFF,
                strokeStyle: { width: 2, cap: "round", join: "round" }
              }
            ]
          )
        }
      }
    }
    Panel(style: ChoiceCopy) {
      Text(text: label, style: control.hovered ? CheckTextHover : CheckText)
      if !isEmpty(description) { Text(text: description, style: CheckMeta) }
    }
  }
}

component CheckSetting(key: key, label: string, detail: string, checked: boolean) {
  Checkbox(
    key: key,
    label: label,
    description: detail,
    defaultChecked: checked,
    presentationTemplate: DeckCheckboxPresentation,
    layout: { width: { weight: 1 }, height: 40 }
  )
}

component SectionTitle(label: string) {
  Panel(style: SectionHeadingRow) {
    Text(text: label, style: SectionHeading)
    Panel(style: SectionRule)
  }
}

component GeneralPage(tab: string) {
  Panel(style: SettingsStack) {
    SectionTitle(label: tab == "WORKSPACE" ? "SESSION" : "RUNTIME")
    Panel(style: SettingsCard) {
      if tab == "WORKSPACE" {
        CheckSetting(key: "deck.restore", label: "Restore previous workspace", detail: "Reopen the last project and tool layout", checked: true)
        CheckSetting(key: "deck.autosave", label: "Continuous save", detail: "Persist document changes while editing", checked: true)
        CheckSetting(key: "deck.recent", label: "Show recent activity", detail: "Surface updates from collaborators", checked: false)
      } else {
        CheckSetting(key: "deck.background", label: "Background processing", detail: "Continue exports when the window is inactive", checked: true)
        CheckSetting(key: "deck.telemetry", label: "Local performance telemetry", detail: "Collect frame timing without network upload", checked: true)
        CheckSetting(key: "deck.experimental", label: "Preview features", detail: "Enable incomplete workflow experiments", checked: false)
      }
    }

    SectionTitle(label: "PRESENTATION")
    Panel(style: SettingsCard) {
      ChoiceSetting(
        key: "deck.backend",
        label: "Rendering backend",
        description: "Graphics path used for the workspace",
        options: [
          { id: "hardware", label: "Hardware" },
          { id: "compatibility", label: "Compatibility" },
          { id: "reference", label: "Reference" }
        ],
        initial: "hardware"
      )
      ChoiceSetting(
        key: "deck.pacing",
        label: "Frame pacing",
        description: "Balance latency and visual stability",
        options: [
          { id: "smooth", label: "Smooth" },
          { id: "responsive", label: "Responsive" },
          { id: "unbounded", label: "Unbounded" }
        ],
        initial: "smooth"
      )
      ChoiceSetting(
        key: "deck.quality",
        label: "Surface quality",
        description: "Controls effects and text raster detail",
        options: [
          { id: "high", label: "High" },
          { id: "balanced", label: "Balanced" },
          { id: "efficient", label: "Efficient" }
        ],
        initial: "high"
      )
    }

    Panel(style: StatusCard) {
      Panel(style: StatusDot)
      Panel(style: ChoiceCopy) {
        Text(text: "D3D11 adapter ready", style: StatusTitle)
        Text(text: "Hardware effects · low-latency presentation", style: StatusMeta)
      }
      Text(text: "ACTIVE", style: DeckScope)
    }
  }
}

component DisplayPage() {
  Panel(style: SettingsStack) {
    SectionTitle(label: "WORKSPACE DISPLAY")
    Panel(style: SettingsCard) {
      ChoiceSetting(
        key: "deck.scale",
        label: "Interface scale",
        description: "Logical density for controls and text",
        options: [
          { id: "auto", label: "Automatic" },
          { id: "compact", label: "Compact" },
          { id: "comfortable", label: "Comfortable" }
        ],
        initial: "auto"
      )
      ChoiceSetting(
        key: "deck.motion",
        label: "Motion profile",
        description: "Transition character across the workspace",
        options: [
          { id: "fluid", label: "Fluid" },
          { id: "precise", label: "Precise" },
          { id: "reduced", label: "Reduced" }
        ],
        initial: "fluid"
      )
      CheckSetting(key: "deck.contrast", label: "Adaptive glass contrast", detail: "Raise edge energy over dark imagery", checked: true)
      CheckSetting(key: "deck.snap", label: "Pixel-aligned geometry", detail: "Snap thin strokes at the current scale", checked: true)
    }
    SectionTitle(label: "OVERLAYS")
    Panel(style: SettingsCard) {
      CheckSetting(key: "deck.hints", label: "Keyboard hints", detail: "Show shortcuts beside available commands", checked: true)
      CheckSetting(key: "deck.status", label: "Status indicators", detail: "Keep passive system state visible", checked: true)
      CheckSetting(key: "deck.bounds", label: "Safe-area guides", detail: "Display authoring bounds while arranging", checked: false)
    }
  }
}

component InputPage() {
  Panel(style: SettingsStack) {
    SectionTitle(label: "POINTER & KEYBOARD")
    Panel(style: SettingsCard) {
      ChoiceSetting(
        key: "deck.pointer",
        label: "Pointer response",
        description: "Precision profile for authored controls",
        options: [
          { id: "precise", label: "Precise" },
          { id: "direct", label: "Direct" },
          { id: "relaxed", label: "Relaxed" }
        ],
        initial: "precise"
      )
      ChoiceSetting(
        key: "deck.navigation",
        label: "Focus navigation",
        description: "How directional movement selects targets",
        options: [
          { id: "spatial", label: "Spatial" },
          { id: "document", label: "Document order" },
          { id: "hybrid", label: "Hybrid" }
        ],
        initial: "spatial"
      )
      CheckSetting(key: "deck.accelerators", label: "Command accelerators", detail: "Enable application keyboard shortcuts", checked: true)
      CheckSetting(key: "deck.wrapFocus", label: "Wrap focus", detail: "Continue from the opposite edge", checked: false)
    }
  }
}

component AudioPage() {
  Panel(style: SettingsStack) {
    SectionTitle(label: "FEEDBACK")
    Panel(style: SettingsCard) {
      ChoiceSetting(
        key: "deck.feedback",
        label: "Interaction feedback",
        description: "Sound profile for confirmations and alerts",
        options: [
          { id: "subtle", label: "Subtle" },
          { id: "full", label: "Full" },
          { id: "silent", label: "Silent" }
        ],
        initial: "subtle"
      )
      ChoiceSetting(
        key: "deck.output",
        label: "Output device",
        description: "Destination used for workspace audio",
        options: [
          { id: "system", label: "System default" },
          { id: "headset", label: "Studio headset" },
          { id: "speakers", label: "Desk speakers" }
        ],
        initial: "system"
      )
      CheckSetting(key: "deck.alerts", label: "Completion alerts", detail: "Notify when long operations finish", checked: true)
      CheckSetting(key: "deck.focusAudio", label: "Mute during focus mode", detail: "Suppress non-critical workspace sounds", checked: true)
    }
  }
}

component ProfilesPage() {
  Panel(style: SettingsStack) {
    SectionTitle(label: "CONFIGURATION PROFILES")
    Grid(columns: [{ weight: 1 }, { weight: 1 }, { weight: 1 }], style: ProfileGrid) {
      Panel(style: ProfileCardSelected) {
        Panel(style: ProfileBadge) { Text(text: "ACTIVE", style: ProfileBadgeText) }
        Text(text: "Studio", style: ProfileTitle)
        Text(text: "High quality · fluid motion · spatial input", style: ProfileMeta, wrapMode: "WORD")
      }
      Panel(style: ProfileCard) {
        Text(text: "Presentation", style: ProfileTitle)
        Text(text: "Reduced chrome · precise pacing · quiet feedback", style: ProfileMeta, wrapMode: "WORD")
      }
      Panel(style: ProfileCard) {
        Text(text: "Portable", style: ProfileTitle)
        Text(text: "Balanced effects · compact density · efficient output", style: ProfileMeta, wrapMode: "WORD")
      }
    }
    SectionTitle(label: "PROFILE BEHAVIOR")
    Panel(style: SettingsCard) {
      CheckSetting(key: "deck.profileSync", label: "Sync profile with workspace", detail: "Restore the profile associated with each project", checked: true)
      CheckSetting(key: "deck.profilePrompt", label: "Confirm automatic changes", detail: "Ask before a workspace switches profile", checked: false)
    }
  }
}

component AdvancedPage() {
  Panel(style: SettingsStack) {
    SectionTitle(label: "DIAGNOSTICS")
    Panel(style: SettingsCard) {
      CheckSetting(key: "deck.diagnostics", label: "Runtime diagnostics", detail: "Capture actionable warnings from active surfaces", checked: true)
      CheckSetting(key: "deck.frameMarkers", label: "Frame markers", detail: "Publish host and renderer timing boundaries", checked: false)
      CheckSetting(key: "deck.resourceTrace", label: "Resource tracing", detail: "Record image, font, and shader resolution", checked: false)
    }
    SectionTitle(label: "COMPATIBILITY")
    Panel(style: SettingsCard) {
      ChoiceSetting(
        key: "deck.fallback",
        label: "Effect fallback",
        description: "Behavior when a shader backend is unavailable",
        options: [
          { id: "deterministic", label: "Deterministic" },
          { id: "omit", label: "Omit unsupported stage" },
          { id: "strict", label: "Require native backend" }
        ],
        initial: "deterministic"
      )
      CheckSetting(key: "deck.validation", label: "Strict packet validation", detail: "Reject malformed render data before submission", checked: true)
    }
  }
}

component ControlDeck() {
  state category = "GENERAL";
  state generalTab = "WORKSPACE";

  Panel(style: DeckRoot, material: material("deck:color-bath")) {
    Panel(style: DeckShell, enter: DeckEnter) {
      Panel(style: DeckLensGlint)
      Panel(style: DeckHeader) {
        Text(text: "Lattice", style: DeckTitle)
        Text(text: "CONTROL DECK", style: DeckScope)
        Panel(style: Clear, layout: { width: { weight: 1 }, height: 1 })
        Text(text: "F2 · close", style: DeckHint)
      }
      Panel(style: DeckHeaderRule)
      Panel(style: DeckBody) {
        Panel(style: DeckSidebar) {
          CategoryButton(id: "deck.general", icon: "GENERAL", label: "General", selected: category == "GENERAL", activate: action("state.set", name: "category", value: "GENERAL"))
          CategoryButton(id: "deck.display", icon: "DISPLAY", label: "Display", selected: category == "DISPLAY", activate: action("state.set", name: "category", value: "DISPLAY"))
          CategoryButton(id: "deck.input", icon: "INPUT", label: "Input", selected: category == "INPUT", activate: action("state.set", name: "category", value: "INPUT"))
          CategoryButton(id: "deck.audio", icon: "AUDIO", label: "Audio", selected: category == "AUDIO", activate: action("state.set", name: "category", value: "AUDIO"))
          CategoryButton(id: "deck.profiles", icon: "PROFILES", label: "Profiles", selected: category == "PROFILES", activate: action("state.set", name: "category", value: "PROFILES"))
          CategoryButton(id: "deck.advanced", icon: "ADVANCED", label: "Advanced", selected: category == "ADVANCED", activate: action("state.set", name: "category", value: "ADVANCED"))
          Panel(style: Clear, layout: { width: { weight: 1 }, height: { weight: 1 } })
          Panel(style: SidebarFoot) {
            Text(text: "Configuration is local", style: SidebarFootTitle)
            Text(text: "Examples are retained by this surface only.", style: SidebarFootCopy, wrapMode: "WORD")
          }
        }

        Panel(style: ContentHost) {
          Panel(style: ContentHeader) {
            Panel(style: ChoiceCopy) {
              Text(
                text: category == "GENERAL" ? "General" : category == "DISPLAY" ? "Display" : category == "INPUT" ? "Input" : category == "AUDIO" ? "Audio" : category == "PROFILES" ? "Profiles" : "Advanced",
                style: ContentTitle
              )
              Text(text: "Workspace configuration and behavior", style: ContentSubtitle)
            }
            if category == "GENERAL" {
              Panel(style: SegmentRail) {
                SegmentButton(id: "deck.tab.workspace", label: "Workspace", selected: generalTab == "WORKSPACE", activate: action("state.set", name: "generalTab", value: "WORKSPACE"))
                SegmentButton(id: "deck.tab.runtime", label: "Runtime", selected: generalTab == "RUNTIME", activate: action("state.set", name: "generalTab", value: "RUNTIME"))
              }
            }
          }

          Scroll(key: "deck.settings.scroll", vertical: true, horizontal: false, style: DeckScroll) {
            if category == "DISPLAY" {
              DisplayPage()
            } else if category == "INPUT" {
              InputPage()
            } else if category == "AUDIO" {
              AudioPage()
            } else if category == "PROFILES" {
              ProfilesPage()
            } else if category == "ADVANCED" {
              AdvancedPage()
            } else {
              GeneralPage(tab: generalTab)
            }
          }
        }
      }
    }
  }
}

overlay ControlDeckMenu {
  root ControlDeck()
}
