{
  "version": 1,
  "application": {
    "id": "control-deck.canvas.headless",
    "module": "assets/strata/ui/control_deck.strata",
    "schemas": "assets/strata/ui/control_deck.schemas.json",
    "root": "ControlDeckMenu",
    "actions": ["control-deck.canvas.commit"]
  },
  "surface": {
    "id": "control-deck.canvas.headless",
    "role": "overlay",
    "backend": "d3d11",
    "width": 1280,
    "height": 800,
    "scale": 1,
    "clearColor": "#090b0fff",
    "fonts": [
      {"id": "strata:fonts/default-medium", "resource": "assets/strata/fonts/medium.ttf"},
      {"id": "strata:fonts/default", "resource": "assets/strata/fonts/default.ttf"},
      {"id": "strata:fonts/mono", "resource": "assets/strata/fonts/mono.ttf"}
    ]
  },
  "snapshots": [],
  "steps": [
    {"advance": {"milliseconds": 220, "frames": 2}},
    {"click": {"key": "deck.canvas"}},
    {"advance": {"milliseconds": 180, "frames": 2}},
    {"capture": "canvas"},
    {"pointerDrag": {
      "from": {"x": 709, "y": 436},
      "to": {"x": 709, "y": 360},
      "milliseconds": 96,
      "steps": 8
    }},
    {"capture": "edited"},
    {"pointerDrag": {
      "from": {"x": 460, "y": 330},
      "to": {"x": 820, "y": 500},
      "milliseconds": 240,
      "steps": 60
    }},
    {"capture": "selected"},
    {"scroll": {"key": "deck.canvas.editor", "deltaY": 1}},
    {"capture": "zoomed"},
    {"pointerDrag": {
      "from": {"x": 900, "y": 450},
      "to": {"x": 700, "y": 450},
      "milliseconds": 96,
      "steps": 8,
      "button": "right"
    }},
    {"capture": "panned"},
    {"key": {"name": "up"}},
    {"capture": "keyboard"},
    {"advance": {"milliseconds": 200, "frames": 12}},
    {"capture": "idle"}
  ]
}
