# Include direction for the engine layers under native/src.
#
# Every engine library is declared with strata_add_layer(), which records the src/ directories it
# owns. A source in one of those directories may include `"dir/..."` only when `dir` belongs to its
# own library or to a library it links, directly or transitively, and may include a public
# `<strata/...>` header only when it links the library that publishes it. The rules are derived
# from the link graph, so linking a layer is what permits including it.
#
# The check runs at configure time and again as the strata.layering test, which re-reads the
# sources so an include added after configuring is still caught.

# Writes "<directory>=<allowed directory or <strata/header>>;..." lines for every layer directory.
function(strata_write_layer_rules output)
    get_property(targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
    set(lines)
    foreach(target IN LISTS targets)
        get_target_property(directories ${target} STRATA_LAYER_DIRECTORIES)
        if(NOT directories)
            continue()
        endif()
        set(allowed)
        set(pending ${target})
        set(visited)
        while(pending)
            list(POP_FRONT pending current)
            if(TARGET ${current})
                get_target_property(aliased ${current} ALIASED_TARGET)
                if(aliased)
                    set(current ${aliased})
                endif()
            endif()
            if(NOT TARGET ${current} OR current IN_LIST visited)
                continue()
            endif()
            list(APPEND visited ${current})
            get_target_property(owned ${current} STRATA_LAYER_DIRECTORIES)
            if(owned)
                list(APPEND allowed ${owned})
            endif()
            get_target_property(headers ${current} STRATA_PUBLIC_HEADERS)
            if(headers)
                foreach(header IN LISTS headers)
                    list(APPEND allowed "<strata/${header}>")
                endforeach()
            endif()
            get_target_property(type ${current} TYPE)
            if(type STREQUAL "INTERFACE_LIBRARY")
                get_target_property(links ${current} INTERFACE_LINK_LIBRARIES)
            else()
                get_target_property(links ${current} LINK_LIBRARIES)
            endif()
            if(links)
                foreach(link IN LISTS links)
                    string(REGEX REPLACE "^\\$<LINK_ONLY:(.*)>$" "\\1" link "${link}")
                    if(NOT link MATCHES "^\\$<")
                        list(APPEND pending ${link})
                    endif()
                endforeach()
            endif()
        endwhile()
        list(REMOVE_DUPLICATES allowed)
        list(SORT allowed)
        string(REPLACE ";" "," allowed_text "${allowed}")
        foreach(directory IN LISTS directories)
            list(APPEND lines "${directory}=${allowed_text}")
        endforeach()
    endforeach()
    list(SORT lines)
    string(REPLACE ";" "\n" content "${lines}")
    file(CONFIGURE OUTPUT "${output}" CONTENT "${content}\n" @ONLY)
endfunction()

# Fails with every include that crosses a layer boundary the link graph does not allow.
function(strata_check_layer_includes source_root rules_file)
    get_filename_component(source_root "${source_root}" ABSOLUTE)
    file(STRINGS "${rules_file}" rules)
    set(layer_directories)
    foreach(rule IN LISTS rules)
        string(REGEX MATCH "^([^=]+)=" ignored "${rule}")
        list(APPEND layer_directories "${CMAKE_MATCH_1}")
    endforeach()
    set(violations)
    foreach(rule IN LISTS rules)
        string(REGEX MATCH "^([^=]+)=(.*)$" ignored "${rule}")
        set(directory "${CMAKE_MATCH_1}")
        string(REPLACE "," ";" allowed "${CMAKE_MATCH_2}")
        file(GLOB_RECURSE files
            "${source_root}/${directory}/*.cpp"
            "${source_root}/${directory}/*.hpp"
            "${source_root}/${directory}/*.h"
            "${source_root}/${directory}/*.inc"
        )
        foreach(file IN LISTS files)
            file(STRINGS "${file}" includes REGEX "^[ \t]*#[ \t]*include[ \t]*[<\"]")
            foreach(line IN LISTS includes)
                set(target "")
                if(line MATCHES "#[ \t]*include[ \t]*\"([^\"/]+)/[^\"]*\"")
                    set(target "${CMAKE_MATCH_1}")
                elseif(line MATCHES "#[ \t]*include[ \t]*<strata/([^>]+)>")
                    set(target "<strata/${CMAKE_MATCH_1}>")
                endif()
                if(target STREQUAL "" OR target IN_LIST allowed)
                    continue()
                endif()
                file(RELATIVE_PATH relative "${source_root}" "${file}")
                string(STRIP "${line}" line)
                list(APPEND violations "  src/${relative}: ${line}")
            endforeach()
        endforeach()
    endforeach()
    if(violations)
        list(JOIN violations "\n" text)
        message(FATAL_ERROR
            "Engine layers may include only what their library links (see ${rules_file}):\n"
            "${text}")
    endif()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
    if(NOT DEFINED STRATA_SOURCE_ROOT OR NOT DEFINED STRATA_LAYER_RULES)
        message(FATAL_ERROR "Set STRATA_SOURCE_ROOT and STRATA_LAYER_RULES")
    endif()
    strata_check_layer_includes("${STRATA_SOURCE_ROOT}" "${STRATA_LAYER_RULES}")
    message(STATUS "Engine layer includes follow the link graph")
endif()
