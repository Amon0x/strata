@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/StrataTargets.cmake")

set_and_check(Strata_REGISTRY "${PACKAGE_PREFIX_DIR}/share/strata/registry-v1.json")
set_and_check(Strata_RESOURCES "${PACKAGE_PREFIX_DIR}/share")
if(EXISTS "${PACKAGE_PREFIX_DIR}/bin/strata_compile${CMAKE_EXECUTABLE_SUFFIX}")
    set(Strata_COMPILER "${PACKAGE_PREFIX_DIR}/bin/strata_compile${CMAKE_EXECUTABLE_SUFFIX}")
else()
    set(Strata_COMPILER "")
endif()
if(EXISTS "${PACKAGE_PREFIX_DIR}/bin/strata_authoring${CMAKE_EXECUTABLE_SUFFIX}")
    set(Strata_AUTHORING "${PACKAGE_PREFIX_DIR}/bin/strata_authoring${CMAKE_EXECUTABLE_SUFFIX}")
else()
    set(Strata_AUTHORING "")
endif()
if(EXISTS "${PACKAGE_PREFIX_DIR}/share/strata/editor/strata-language-@STRATA_VSCODE_VERSION@.vsix")
    set(
        Strata_VSCODE_EXTENSION
        "${PACKAGE_PREFIX_DIR}/share/strata/editor/strata-language-@STRATA_VSCODE_VERSION@.vsix"
    )
else()
    set(Strata_VSCODE_EXTENSION "")
endif()
if(WIN32 AND EXISTS "${PACKAGE_PREFIX_DIR}/bin/strata_desktop.exe")
    set(Strata_DESKTOP_RUNNER "${PACKAGE_PREFIX_DIR}/bin/strata_desktop.exe")
else()
    set(Strata_DESKTOP_RUNNER "")
endif()

check_required_components(Strata)
